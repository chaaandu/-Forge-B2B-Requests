# ── Catalogue ────────────────────────────────────────────────────────────────
# The POS Postgres. Read by the site every 10 minutes (and by `npm run
# catalog:sync`), always inside a READ ONLY transaction. Use a read-only role in
# production — see README. Empty: the site serves data/catalog.json.
POS_DATABASE_URL=
# Where the POS serves product photos from (its public API origin).
POS_PUBLIC_BASE_URL=https://mesa-pos-api-tqiiw3ddga-el.a.run.app
# Recommended: the POS's public storage bucket, so photos skip the POS API (and
# its per-network rate limit) entirely:
#   https://<project>.supabase.co/storage/v1/object/public/mesa-public
POS_MEDIA_BASE_URL=

# ── Request inbox (server-side only) ─────────────────────────────────────────
# The Apps Script web app /exec URL bound to the requests Google Sheet.
# Empty locally: requests are written to .data/requests.jsonl instead.
SHEETS_WEBHOOK_URL=
# Must equal the WEBHOOK_SECRET script property in apps-script/Code.gs.
SHEETS_WEBHOOK_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public origin, used in sitemap.xml and robots.txt. No trailing slash.
SITE_URL=http://localhost:3000

# ── Local only ───────────────────────────────────────────────────────────────
# On a NAT64 network (some phone hotspots) Supabase resolves to 64:ff9b::
# addresses, which the image optimizer refuses as private. Set to 1 locally
# on such a network; it has no effect in production.
# ALLOW_LOCAL_IP=1
